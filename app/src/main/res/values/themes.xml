<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.HearthPaw" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/hearthpaw_primary</item>
        <item name="colorOnPrimary">@color/hearthpaw_on_primary</item>
        <item name="colorPrimaryContainer">@color/hearthpaw_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/hearthpaw_on_primary_container</item>
        <item name="colorSecondary">@color/hearthpaw_secondary</item>
        <item name="colorOnSecondary">@color/hearthpaw_on_secondary</item>
        <item name="colorSecondaryContainer">@color/hearthpaw_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/hearthpaw_on_secondary_container</item>
        <item name="colorTertiary">@color/hearthpaw_tertiary</item>
        <item name="colorSurface">@color/hearthpaw_surface</item>
        <item name="colorSurfaceVariant">@color/hearthpaw_surface_variant</item>
        <item name="colorOutline">@color/hearthpaw_outline</item>
        <item name="android:colorBackground">@color/hearthpaw_background</item>
        <item name="android:statusBarColor">@color/hearthpaw_primary_container</item>
        <item name="android:navigationBarColor">@color/hearthpaw_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="materialCardViewStyle">@style/Widget.HearthPaw.Card</item>
        <item name="materialButtonStyle">@style/Widget.HearthPaw.Button</item>
    </style>

    <style name="Theme.HearthPaw" parent="Base.Theme.HearthPaw" />

    <style name="Widget.HearthPaw.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">2dp</item>
    </style>

    <style name="Widget.HearthPaw.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">22dp</item>
    </style>

    <style name="TextAppearance.HearthPaw.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>