<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    android:background="@drawable/bg_soft_card"
    app:cardCornerRadius="24dp"
    app:cardElevation="4dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/hearthpaw_outline">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/item_pet_photo"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginEnd="12dp"
            android:background="@color/hearthpaw_card_soft"
            android:contentDescription="@string/pet_photo_description"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="2dp">

            <TextView
                android:id="@+id/item_pet_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/hearthpaw_on_primary_container"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/item_pet_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/hearthpaw_text_soft"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/item_pet_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/hearthpaw_text_soft" />

        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>